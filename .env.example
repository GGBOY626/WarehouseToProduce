DB_NAME=warehouse
DB_USERNAME=warehouse_app
DB_PASSWORD=replace_with_a_long_random_password
MYSQL_ROOT_PASSWORD=replace_with_another_long_random_password
UPLOAD_HOST_DIR=/opt/warehouse-system/data/uploads
HTTP_BIND_PORT=8088
APP_BIND_ADDRESS=0.0.0.0
TZ=Pacific/Auckland
BACKUP_DIR=/opt/warehouse-system/data/backups
BACKUP_RETENTION_DAYS=30
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Gemini Key is injected ONLY into ai-service, never backend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_ENABLED=true
AI_INTERNAL_TOKEN=
